{
  "$defs": {
    "CaseExecutionStatus": {
      "enum": [
        "PENDING",
        "RUNNING",
        "PASS",
        "FAIL",
        "ERROR",
        "INFRA_RECOVERED"
      ],
      "title": "CaseExecutionStatus",
      "type": "string"
    },
    "FailureType": {
      "enum": [
        "ASSERTION_FAILED",
        "FIXTURE_SETUP",
        "FIXTURE_CLEANUP",
        "INFRA_NETWORK",
        "INFRA_TIMEOUT",
        "INFRA_RESOURCE"
      ],
      "title": "FailureType",
      "type": "string"
    },
    "MvpCaseReport": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "cleanup_status": {
          "enum": [
            "PASS",
            "FAILED"
          ],
          "title": "Cleanup Status",
          "type": "string"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "number"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "failure_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/FailureType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "primary_status": {
          "$ref": "#/$defs/CaseExecutionStatus"
        },
        "recovery_status": {
          "enum": [
            "PASS",
            "FAILED"
          ],
          "title": "Recovery Status",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CaseExecutionStatus"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/MvpStepReport"
          },
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "case_id",
        "status",
        "primary_status",
        "cleanup_status",
        "recovery_status",
        "duration_ms",
        "steps"
      ],
      "title": "MvpCaseReport",
      "type": "object"
    },
    "MvpStepReport": {
      "additionalProperties": false,
      "properties": {
        "affected_rows": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Affected Rows"
        },
        "column_types": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Column Types",
          "type": "array"
        },
        "columns": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Columns",
          "type": "array"
        },
        "duration_ms": {
          "minimum": 0,
          "title": "Duration Ms",
          "type": "number"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "error_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Type"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "logical_types": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Logical Types",
          "type": "array"
        },
        "rows": {
          "default": [],
          "items": {
            "items": {},
            "type": "array"
          },
          "title": "Rows",
          "type": "array"
        },
        "sqlstate": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sqlstate"
        },
        "status": {
          "$ref": "#/$defs/StepStatus"
        }
      },
      "required": [
        "id",
        "kind",
        "status",
        "duration_ms"
      ],
      "title": "MvpStepReport",
      "type": "object"
    },
    "MvpTargetReport": {
      "additionalProperties": false,
      "description": "Typed target context emitted by the bootstrap runner.",
      "properties": {
        "database_alias": {
          "title": "Database Alias",
          "type": "string"
        },
        "host_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Host Hash",
          "type": "string"
        },
        "sql_runtime_profile_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sql Runtime Profile Id"
        }
      },
      "required": [
        "database_alias",
        "host_hash"
      ],
      "title": "MvpTargetReport",
      "type": "object"
    },
    "StepStatus": {
      "enum": [
        "PENDING",
        "RUNNING",
        "PASS",
        "FAIL",
        "ERROR",
        "SKIPPED"
      ],
      "title": "StepStatus",
      "type": "string"
    }
  },
  "$id": "xgtest://schema/1.1/MvpRunReport",
  "additionalProperties": false,
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/MvpCaseReport"
      },
      "title": "Cases",
      "type": "array"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/CaseExecutionStatus"
    },
    "target": {
      "$ref": "#/$defs/MvpTargetReport"
    }
  },
  "required": [
    "run_id",
    "started_at",
    "finished_at",
    "target",
    "cases",
    "status"
  ],
  "title": "MvpRunReport",
  "type": "object",
  "x-xg-contract-version": "1.1"
}
