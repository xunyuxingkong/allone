{
  "$defs": {
    "CaseAssetStatus": {
      "enum": [
        "draft",
        "generated",
        "review",
        "active",
        "disabled",
        "deprecated"
      ],
      "title": "CaseAssetStatus",
      "type": "string"
    },
    "ComparisonProfile": {
      "additionalProperties": false,
      "properties": {
        "canonical_version": {
          "const": "1",
          "default": "1",
          "title": "Canonical Version",
          "type": "string"
        },
        "error_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Profile"
        },
        "float_policy": {
          "default": "canonical_ieee754",
          "title": "Float Policy",
          "type": "string"
        },
        "mode": {
          "enum": [
            "exact",
            "rowsort",
            "sha256",
            "expected_error"
          ],
          "title": "Mode",
          "type": "string"
        },
        "normalization_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalization Profile"
        },
        "timestamp_policy": {
          "default": "rfc3339",
          "title": "Timestamp Policy",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "ComparisonProfile",
      "type": "object"
    },
    "CoverageClaim": {
      "additionalProperties": false,
      "properties": {
        "assertion_refs": {
          "items": {
            "type": "string"
          },
          "title": "Assertion Refs",
          "type": "array"
        },
        "assignment": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Assignment",
          "type": "object"
        },
        "claim_id": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Claim Id",
          "type": "string"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "model_version": {
          "title": "Model Version",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "model_id",
        "model_version",
        "assignment",
        "assertion_refs"
      ],
      "title": "CoverageClaim",
      "type": "object"
    },
    "CoverageReview": {
      "additionalProperties": false,
      "properties": {
        "evidence_ref": {
          "title": "Evidence Ref",
          "type": "string"
        },
        "review_input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Review Input Hash",
          "type": "string"
        }
      },
      "required": [
        "review_input_hash",
        "evidence_ref"
      ],
      "title": "CoverageReview",
      "type": "object"
    },
    "EffectiveMetadata": {
      "additionalProperties": false,
      "properties": {
        "cleanup_timeout": {
          "default": "30s",
          "pattern": "^\\d+(ms|s|m|h)$",
          "title": "Cleanup Timeout",
          "type": "string"
        },
        "complexity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Complexity"
        },
        "destructive": {
          "default": false,
          "title": "Destructive",
          "type": "boolean"
        },
        "disabled_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disabled Reason"
        },
        "execution_class": {
          "default": "sql",
          "title": "Execution Class",
          "type": "string"
        },
        "feature": {
          "$ref": "#/$defs/FeatureKey"
        },
        "generated_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated By"
        },
        "id": {
          "pattern": "^[A-Z][A-Z0-9_.-]*$",
          "title": "Id",
          "type": "string"
        },
        "idempotency": {
          "default": "idempotent",
          "title": "Idempotency",
          "type": "string"
        },
        "isolation": {
          "$ref": "#/$defs/IsolationScope"
        },
        "level": {
          "$ref": "#/$defs/Level"
        },
        "metadata_version": {
          "title": "Metadata Version",
          "type": "string"
        },
        "module": {
          "title": "Module",
          "type": "string"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner"
        },
        "parallel": {
          "default": false,
          "title": "Parallel",
          "type": "boolean"
        },
        "replaced_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Replaced By"
        },
        "requirements": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EnvironmentRequirement"
          },
          "title": "Requirements",
          "type": "array"
        },
        "reset_contract": {
          "default": "default",
          "title": "Reset Contract",
          "type": "string"
        },
        "resources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ResourceRequest"
          },
          "title": "Resources",
          "type": "array"
        },
        "retry": {
          "default": 0,
          "minimum": 0,
          "title": "Retry",
          "type": "integer"
        },
        "scenario": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scenario"
        },
        "since": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Since"
        },
        "status": {
          "$ref": "#/$defs/CaseAssetStatus"
        },
        "subfeature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subfeature"
        },
        "tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "timeout": {
          "pattern": "^\\d+(ms|s|m|h)$",
          "title": "Timeout",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "until": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Until"
        }
      },
      "required": [
        "metadata_version",
        "id",
        "title",
        "module",
        "feature",
        "level",
        "status",
        "timeout",
        "isolation"
      ],
      "title": "EffectiveMetadata",
      "type": "object"
    },
    "EnvironmentRequirement": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "title": "Capability",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "capability"
      ],
      "title": "EnvironmentRequirement",
      "type": "object"
    },
    "ExpectedError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "message_pattern": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message Pattern"
        },
        "sqlstate": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sqlstate"
        }
      },
      "title": "ExpectedError",
      "type": "object"
    },
    "ExpectedHash": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "sha256"
      ],
      "title": "ExpectedHash",
      "type": "object"
    },
    "ExpectedRows": {
      "additionalProperties": false,
      "properties": {
        "rows": {
          "items": {
            "items": {},
            "type": "array"
          },
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "rows"
      ],
      "title": "ExpectedRows",
      "type": "object"
    },
    "ExpectedStatement": {
      "additionalProperties": false,
      "properties": {
        "affected_rows": {
          "minimum": 0,
          "title": "Affected Rows",
          "type": "integer"
        }
      },
      "required": [
        "affected_rows"
      ],
      "title": "ExpectedStatement",
      "type": "object"
    },
    "FeatureKey": {
      "enum": [
        "join",
        "union",
        "ddl_table",
        "string_function",
        "query"
      ],
      "title": "FeatureKey",
      "type": "string"
    },
    "FixtureRef": {
      "additionalProperties": false,
      "properties": {
        "content_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "fixture_id": {
          "title": "Fixture Id",
          "type": "string"
        }
      },
      "required": [
        "fixture_id",
        "content_hash"
      ],
      "title": "FixtureRef",
      "type": "object"
    },
    "IsolationScope": {
      "enum": [
        "session",
        "worker_schema",
        "case_schema",
        "database",
        "cluster"
      ],
      "title": "IsolationScope",
      "type": "string"
    },
    "Level": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ],
      "title": "Level",
      "type": "string"
    },
    "ResourceAccessMode": {
      "enum": [
        "shared_read",
        "shared_write",
        "exclusive"
      ],
      "title": "ResourceAccessMode",
      "type": "string"
    },
    "ResourceRequest": {
      "additionalProperties": false,
      "properties": {
        "access_mode": {
          "$ref": "#/$defs/ResourceAccessMode"
        },
        "impact_scope": {
          "title": "Impact Scope",
          "type": "string"
        },
        "parent_identity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Identity"
        },
        "quantity": {
          "default": 1,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "resource_id": {
          "title": "Resource Id",
          "type": "string"
        },
        "resource_type": {
          "title": "Resource Type",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/IsolationScope"
        }
      },
      "required": [
        "resource_type",
        "resource_id",
        "scope",
        "access_mode",
        "impact_scope"
      ],
      "title": "ResourceRequest",
      "type": "object"
    },
    "SourceInfo": {
      "additionalProperties": false,
      "properties": {
        "relative_path": {
          "minLength": 1,
          "title": "Relative Path",
          "type": "string"
        },
        "source_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Hash",
          "type": "string"
        }
      },
      "required": [
        "relative_path",
        "source_hash"
      ],
      "title": "SourceInfo",
      "type": "object"
    },
    "SqlStep": {
      "additionalProperties": false,
      "properties": {
        "comparison": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComparisonProfile"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "expected": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExpectedRows"
            },
            {
              "$ref": "#/$defs/ExpectedHash"
            },
            {
              "$ref": "#/$defs/ExpectedError"
            },
            {
              "$ref": "#/$defs/ExpectedStatement"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "setup",
            "statement",
            "query",
            "cleanup"
          ],
          "title": "Kind",
          "type": "string"
        },
        "sql": {
          "minLength": 1,
          "title": "Sql",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "sql"
      ],
      "title": "SqlStep",
      "type": "object"
    }
  },
  "$id": "xgtest://schema/1.1/UnifiedCase",
  "additionalProperties": false,
  "properties": {
    "compiled_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Compiled Hash",
      "type": "string"
    },
    "coverage": {
      "default": [],
      "items": {
        "$ref": "#/$defs/CoverageClaim"
      },
      "title": "Coverage",
      "type": "array"
    },
    "coverage_review": {
      "anyOf": [
        {
          "$ref": "#/$defs/CoverageReview"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "dependency_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dependency Hash",
      "type": "string"
    },
    "fixtures": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FixtureRef"
      },
      "title": "Fixtures",
      "type": "array"
    },
    "metadata": {
      "$ref": "#/$defs/EffectiveMetadata"
    },
    "semantic_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Semantic Hash",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceInfo"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/SqlStep"
      },
      "title": "Steps",
      "type": "array"
    }
  },
  "required": [
    "metadata",
    "source",
    "steps",
    "dependency_hash",
    "compiled_hash",
    "semantic_hash"
  ],
  "title": "UnifiedCase",
  "type": "object",
  "x-xg-contract-version": "1.1"
}
