{
  "$defs": {
    "CaseAssetStatus": {
      "enum": [
        "draft",
        "generated",
        "review",
        "active",
        "disabled",
        "deprecated"
      ],
      "title": "CaseAssetStatus",
      "type": "string"
    },
    "EnvironmentRequirement": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "title": "Capability",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "capability"
      ],
      "title": "EnvironmentRequirement",
      "type": "object"
    },
    "FeatureKey": {
      "enum": [
        "join",
        "union",
        "ddl_table",
        "string_function",
        "query"
      ],
      "title": "FeatureKey",
      "type": "string"
    },
    "IsolationScope": {
      "enum": [
        "session",
        "worker_schema",
        "case_schema",
        "database",
        "cluster"
      ],
      "title": "IsolationScope",
      "type": "string"
    },
    "Level": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ],
      "title": "Level",
      "type": "string"
    },
    "ResourceAccessMode": {
      "enum": [
        "shared_read",
        "shared_write",
        "exclusive"
      ],
      "title": "ResourceAccessMode",
      "type": "string"
    },
    "ResourceRequest": {
      "additionalProperties": false,
      "properties": {
        "access_mode": {
          "$ref": "#/$defs/ResourceAccessMode"
        },
        "impact_scope": {
          "title": "Impact Scope",
          "type": "string"
        },
        "parent_identity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Identity"
        },
        "quantity": {
          "default": 1,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "resource_id": {
          "title": "Resource Id",
          "type": "string"
        },
        "resource_type": {
          "title": "Resource Type",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/IsolationScope"
        }
      },
      "required": [
        "resource_type",
        "resource_id",
        "scope",
        "access_mode",
        "impact_scope"
      ],
      "title": "ResourceRequest",
      "type": "object"
    }
  },
  "$id": "xgtest://schema/1.1/EffectiveMetadata",
  "additionalProperties": false,
  "properties": {
    "cleanup_timeout": {
      "default": "30s",
      "pattern": "^\\d+(ms|s|m|h)$",
      "title": "Cleanup Timeout",
      "type": "string"
    },
    "complexity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Complexity"
    },
    "destructive": {
      "default": false,
      "title": "Destructive",
      "type": "boolean"
    },
    "disabled_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Disabled Reason"
    },
    "execution_class": {
      "default": "sql",
      "title": "Execution Class",
      "type": "string"
    },
    "feature": {
      "$ref": "#/$defs/FeatureKey"
    },
    "generated_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generated By"
    },
    "id": {
      "pattern": "^[A-Z][A-Z0-9_.-]*$",
      "title": "Id",
      "type": "string"
    },
    "idempotency": {
      "default": "idempotent",
      "title": "Idempotency",
      "type": "string"
    },
    "isolation": {
      "$ref": "#/$defs/IsolationScope"
    },
    "level": {
      "$ref": "#/$defs/Level"
    },
    "metadata_version": {
      "title": "Metadata Version",
      "type": "string"
    },
    "module": {
      "title": "Module",
      "type": "string"
    },
    "owner": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner"
    },
    "parallel": {
      "default": false,
      "title": "Parallel",
      "type": "boolean"
    },
    "replaced_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Replaced By"
    },
    "requirements": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EnvironmentRequirement"
      },
      "title": "Requirements",
      "type": "array"
    },
    "reset_contract": {
      "default": "default",
      "title": "Reset Contract",
      "type": "string"
    },
    "resources": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ResourceRequest"
      },
      "title": "Resources",
      "type": "array"
    },
    "retry": {
      "default": 0,
      "minimum": 0,
      "title": "Retry",
      "type": "integer"
    },
    "scenario": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scenario"
    },
    "since": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Since"
    },
    "status": {
      "$ref": "#/$defs/CaseAssetStatus"
    },
    "subfeature": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subfeature"
    },
    "tags": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "timeout": {
      "pattern": "^\\d+(ms|s|m|h)$",
      "title": "Timeout",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "until": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Until"
    }
  },
  "required": [
    "metadata_version",
    "id",
    "title",
    "module",
    "feature",
    "level",
    "status",
    "timeout",
    "isolation"
  ],
  "title": "EffectiveMetadata",
  "type": "object",
  "x-xg-contract-version": "1.1"
}
