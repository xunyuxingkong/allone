{
  "$id": "xgtest://schema/1.1/RuntimeProfile",
  "additionalProperties": false,
  "description": "Published, validated SQL runtime profile envelope.",
  "properties": {
    "driver": {
      "additionalProperties": true,
      "title": "Driver",
      "type": "object"
    },
    "evidence_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Evidence Sha256",
      "type": "string"
    },
    "identity": {
      "additionalProperties": true,
      "title": "Identity",
      "type": "object"
    },
    "profile_schema_version": {
      "const": "0.2",
      "title": "Profile Schema Version",
      "type": "string"
    },
    "sql_runtime_profile_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sql Runtime Profile Id",
      "type": "string"
    },
    "target": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Target",
      "type": "object"
    }
  },
  "required": [
    "profile_schema_version",
    "identity",
    "target",
    "driver",
    "evidence_sha256",
    "sql_runtime_profile_id"
  ],
  "title": "RuntimeProfile",
  "type": "object",
  "x-xg-contract-version": "1.1"
}
