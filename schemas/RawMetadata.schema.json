{
  "$defs": {
    "CaseAssetStatus": {
      "enum": [
        "draft",
        "generated",
        "review",
        "active",
        "disabled",
        "deprecated"
      ],
      "title": "CaseAssetStatus",
      "type": "string"
    },
    "FeatureKey": {
      "enum": [
        "join",
        "union",
        "ddl_table",
        "string_function",
        "query"
      ],
      "title": "FeatureKey",
      "type": "string"
    },
    "IsolationScope": {
      "enum": [
        "session",
        "worker_schema",
        "case_schema",
        "database",
        "cluster"
      ],
      "title": "IsolationScope",
      "type": "string"
    },
    "Level": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ],
      "title": "Level",
      "type": "string"
    }
  },
  "$id": "xgtest://schema/1.1/RawMetadata",
  "additionalProperties": false,
  "properties": {
    "cleanup_timeout": {
      "anyOf": [
        {
          "pattern": "^\\d+(ms|s|m|h)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cleanup Timeout"
    },
    "complexity": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Complexity"
    },
    "destructive": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Destructive"
    },
    "disabled_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Disabled Reason"
    },
    "execution_class": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Execution Class"
    },
    "feature": {
      "anyOf": [
        {
          "$ref": "#/$defs/FeatureKey"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "generated_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generated By"
    },
    "id": {
      "anyOf": [
        {
          "pattern": "^[A-Z][A-Z0-9_.-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Id"
    },
    "idempotency": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Idempotency"
    },
    "isolation": {
      "anyOf": [
        {
          "$ref": "#/$defs/IsolationScope"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "level": {
      "anyOf": [
        {
          "$ref": "#/$defs/Level"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "metadata_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Metadata Version"
    },
    "module": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Module"
    },
    "owner": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owner"
    },
    "parallel": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parallel"
    },
    "replaced_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Replaced By"
    },
    "reset_contract": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reset Contract"
    },
    "retry": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retry"
    },
    "scenario": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scenario"
    },
    "since": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Since"
    },
    "status": {
      "anyOf": [
        {
          "$ref": "#/$defs/CaseAssetStatus"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "subfeature": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subfeature"
    },
    "tags": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "timeout": {
      "anyOf": [
        {
          "pattern": "^\\d+(ms|s|m|h)$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Timeout"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "until": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Until"
    }
  },
  "title": "RawMetadata",
  "type": "object",
  "x-xg-contract-version": "1.1"
}
